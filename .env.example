HTTP_ADDR=:8080
# Comma-separated list supported (first one is default fallback).
# Examples:
# - local web:  http://localhost:5173
# - pages api:  https://artem5438.github.io
# - tauri api:  tauri://localhost,http://tauri.localhost
CORS_ORIGIN=http://localhost:5173,tauri://localhost,http://tauri.localhost

# MinIO Community: global CORS only (per-bucket mc cors set needs AIStor).
# Comma-separated origins for media from Pages/PWA/Tauri/LAN.
MINIO_CORS_ALLOW_ORIGIN=https://artem5438.github.io,http://localhost:5173,tauri://localhost
JWT_SECRET=dev-jwt-secret

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=lab2_db

REDIS_ADDR=localhost:6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=publishing-media
# Must match frontend VITE_MEDIA_BASE_URL.
# - Pages/PWA: HTTPS tunnel URL
# - Tauri/API LAN: http://<LAN_IP>:9000/publishing-media
MINIO_PUBLIC_URL=http://localhost:9000/publishing-media
MINIO_USE_SSL=false
